# Copy to .env and fill in the two secrets. Never commit .env (it is in
# .gitignore). Generate values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Required for POST /events and PATCH /alerts/{id} (sent as the X-API-Key
# header). With no key set, write endpoints refuse every request.
SENTINELFLOW_API_KEY=

# Required by docker compose for the Postgres container.
POSTGRES_PASSWORD=

# Database. SQLite by default (zero setup): backend/sentinelflow.db, shared
# by the API and scripts/load_dataset.py. For Docker Compose, seed from the
# host with:
# DATABASE_URL=postgresql://sentinelflow:<POSTGRES_PASSWORD>@localhost:5432/sentinelflow

# Rate limits per client address, per process (see backend/app/security.py)
RATE_LIMIT_READS_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=120
# Largest accepted request body, in bytes
MAX_REQUEST_BYTES=16384

# Isolation Forest
ML_CONTAMINATION=0.15
ML_RANDOM_STATE=42

# Risk scoring (see backend/app/detection/risk.py)
# How much an Isolation Forest hit adds on top of a rule that already fired
ML_WEIGHT=0.4
# Ceiling for ML-only alerts (no rule fired); 0.55 caps them at MEDIUM
ML_ONLY_MAX_CONFIDENCE=0.55
