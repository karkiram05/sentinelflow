# Copy to .env and adjust as needed. All values have working local defaults.

# SQLite by default (zero setup): backend/sentinelflow.db, shared by the API
# and scripts/load_dataset.py. For Docker Compose / production, use:
# DATABASE_URL=postgresql://sentinelflow:sentinelflow@localhost:5432/sentinelflow

# Isolation Forest
ML_CONTAMINATION=0.15
ML_RANDOM_STATE=42

# Risk scoring (see backend/app/detection/risk.py)
# How much an Isolation Forest hit adds on top of a rule that already fired
ML_WEIGHT=0.4
# Ceiling for ML-only alerts (no rule fired); 0.55 caps them at MEDIUM
ML_ONLY_MAX_CONFIDENCE=0.55
