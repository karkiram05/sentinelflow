# Copy to .env and adjust as needed. All values have working local defaults.

# SQLite by default (zero setup). For Docker Compose / production, use:
# DATABASE_URL=postgresql://sentinelflow:sentinelflow@localhost:5432/sentinelflow
DATABASE_URL=sqlite:///./sentinelflow.db

# Isolation Forest
ML_CONTAMINATION=0.15
ML_RANDOM_STATE=42

# Risk scoring weights (must sum to 1.0 to keep risk_score in 0-100)
RULE_WEIGHT=0.6
ML_WEIGHT=0.4
